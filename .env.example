# Session signing secret (required)
SESSION_SECRET=change-me-to-a-random-string

# GitHub OAuth (required when auth.provider is "github")
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Deploy webhook (required for deploy functionality)
DEPLOY_HMAC_SECRET=shared-hmac-secret
DEPLOY_WEBHOOK_PROD=http://localhost:9090/deploy
DEPLOY_WEBHOOK_STAGING=http://localhost:9090/deploy

# Sample engine (used by examples/engine)
# DATABASE_URL=postgres://graphiti:graphiti@localhost:5432/graphiti?sslmode=disable
# GRAPHITI_CALLBACK_URL=http://localhost:8080/api/callbacks/execution
