package svg

import (
	"graphiti/internal/domain"
	"fmt"
)

templ Canvas(wf *domain.Workflow) {
	<svg
		id="workflow-canvas"
		class="workflow-canvas"
		xmlns="http://www.w3.org/2000/svg"
		width="100%"
		height="100%"
		role="application"
		aria-label={ "Workflow canvas: " + wf.Name }
	>
		<defs>
			<pattern id="dot-grid" width="24" height="24" patternUnits="userSpaceOnUse">
				<circle cx="12" cy="12" r="1" fill="var(--grid-dot, #d0d0d0)"/>
			</pattern>
			<marker
				id="arrowhead"
				markerWidth="10"
				markerHeight="7"
				refX="10"
				refY="3.5"
				orient="auto"
			>
				<polygon points="0 0, 10 3.5, 0 7" fill="var(--edge-color, #94a3b8)"/>
			</marker>
		</defs>
		<!-- Grid background -->
		<rect width="100%" height="100%" fill="url(#dot-grid)" class="canvas-grid"/>
		<!-- Main content group (pan/zoom transforms applied here) -->
		<g class="canvas-content" transform="translate(0, 0) scale(1)">
			<!-- Edge layer (below nodes) -->
			<g class="edge-layer">
				for _, edge := range wf.Edges {
					@Edge(wf, edge)
				}
			</g>
			<!-- Node layer -->
			<g class="node-layer">
				for i := range wf.Nodes {
					@Node(&wf.Nodes[i])
				}
			</g>
			<!-- Interaction layer (ghosts, selection rect) -->
			<g class="interaction-layer"></g>
		</g>
	</svg>
}

templ Node(node *domain.NodeInstance) {
	<g
		id={ "node-" + node.ID }
		class="node"
		data-node-id={ node.ID }
		data-definition-id={ node.DefinitionID }
		transform={ fmt.Sprintf("translate(%g, %g)", node.X, node.Y) }
		role="img"
		aria-label={ nodeAriaLabel(node) }
	>
		<!-- Background shape -->
		@nodeShape(node)
		<!-- Header -->
		<rect
			x="0"
			y="0"
			width={ nodeWidth(node) }
			height="32"
			rx="6"
			ry="6"
			class="node-header"
			fill={ headerBg(node) }
		/>
		<!-- Clip the bottom corners of header -->
		<rect
			x="0"
			y="16"
			width={ nodeWidth(node) }
			height="16"
			fill={ headerBg(node) }
		/>
		<!-- Icon -->
		<text x="12" y="22" class="node-icon" fill={ headerColor(node) }>
			{ nodeIcon(node) }
		</text>
		<!-- Title -->
		<text x="32" y="22" class="node-title" fill={ headerColor(node) }>
			{ node.Label }
		</text>
		<!-- Attribute rows for node-body display -->
		if node.Definition != nil {
			for _, ba := range bodyAttrs(node) {
				<text
					x={ fmt.Sprintf("%d", ba.X) }
					y={ fmt.Sprintf("%d", ba.Y) }
					class="node-attr-label"
				>
					{ ba.Label }: { ba.Value }
				</text>
			}
		}
		<!-- Ports -->
		if node.Definition != nil {
			for i, port := range node.Definition.Inputs {
				@Port(node, port, true, i)
			}
			for i, port := range node.Definition.Outputs {
				@Port(node, port, false, i)
			}
		}
	</g>
}

templ Port(node *domain.NodeInstance, port domain.PortDefinition, isInput bool, index int) {
	<circle
		class={ "port", portClass(port.Type, isInput) }
		data-port-id={ port.ID }
		data-port-type={ string(port.Type) }
		data-is-input={ boolStr(isInput) }
		cx={ portX(node, port, isInput) }
		cy={ portY(node, port, isInput, index) }
		r="6"
	>
		<title>{ port.Label }</title>
	</circle>
	if port.Label != "" {
		<text
			class={ portLabelClass(isInput) }
			x={ portLabelX(node, isInput) }
			y={ portLabelY(node, isInput, index) }
		>
			{ port.Label }
		</text>
	}
}

templ Edge(wf *domain.Workflow, edge domain.Edge) {
	<path
		class="edge"
		data-edge-id={ edge.ID }
		data-source-node={ edge.SourceNodeID }
		data-target-node={ edge.TargetNodeID }
		data-source-port={ edge.SourcePortID }
		data-target-port={ edge.TargetPortID }
		d={ edgePath(wf, edge) }
		fill="none"
		stroke="var(--edge-color, #94a3b8)"
		stroke-width="2"
		marker-end="url(#arrowhead)"
		role="img"
		aria-label={ edgeAriaLabel(wf, edge) }
	/>
}

templ nodeShape(node *domain.NodeInstance) {
	if node.Definition != nil && node.Definition.Shape.Type == domain.ShapeDiamond {
		<polygon
			points={ diamondPoints(node) }
			class="node-bg"
			fill="var(--surface)"
			stroke="var(--border)"
			stroke-width="1.5"
		/>
	} else if node.Definition != nil && node.Definition.Shape.Type == domain.ShapeHexagon {
		<polygon
			points={ hexagonPoints(node) }
			class="node-bg"
			fill="var(--surface)"
			stroke="var(--border)"
			stroke-width="1.5"
		/>
	} else if node.Definition != nil && node.Definition.Shape.Type == domain.ShapeSubWorkflow {
		<!-- Double border for sub-workflow -->
		<rect
			x="0"
			y="0"
			width={ nodeWidth(node) }
			height={ nodeHeight(node) }
			rx="8"
			ry="8"
			class="node-bg"
			fill="var(--surface)"
			stroke="var(--border)"
			stroke-width="1.5"
		/>
		<rect
			x="3"
			y="3"
			width={ nodeWidthInset(node, 6) }
			height={ nodeHeightInset(node, 6) }
			rx="6"
			ry="6"
			fill="none"
			stroke="var(--border)"
			stroke-width="1"
		/>
	} else {
		<!-- Default rounded rect -->
		<rect
			x="0"
			y="0"
			width={ nodeWidth(node) }
			height={ nodeHeight(node) }
			rx="8"
			ry="8"
			class="node-bg"
			fill="var(--surface)"
			stroke="var(--border)"
			stroke-width="1.5"
		/>
	}
}

func nodeWidth(node *domain.NodeInstance) string {
	return fmt.Sprintf("%d", calcNodeWidth(node))
}

func nodeWidthInset(node *domain.NodeInstance, inset int) string {
	return fmt.Sprintf("%d", calcNodeWidth(node)-inset)
}

func nodeHeightInt(node *domain.NodeInstance) int {
	h := 80
	if node.Definition != nil {
		bodyAttrs := 0
		for _, a := range node.Definition.Attributes {
			if a.Display == domain.DisplayNodeBody || a.Display == domain.DisplayBoth {
				bodyAttrs++
			}
		}
		inputCount := len(node.Definition.Inputs)
		outputCount := len(node.Definition.Outputs)
		maxPorts := inputCount
		if outputCount > maxPorts {
			maxPorts = outputCount
		}

		headerHeight := 36
		bottomPadding := 12
		portSpacing := 24
		bodyAttrHeight := bodyAttrs * 20
		portsHeight := maxPorts * portSpacing
		contentHeight := bodyAttrHeight
		if portsHeight > contentHeight {
			contentHeight = portsHeight
		}
		h = headerHeight + contentHeight + bottomPadding
		if h < 60 {
			h = 60
		}
	}
	return h
}

func nodeHeight(node *domain.NodeInstance) string {
	return fmt.Sprintf("%d", nodeHeightInt(node))
}

func nodeHeightInset(node *domain.NodeInstance, inset int) string {
	return fmt.Sprintf("%d", nodeHeightInt(node)-inset)
}

func headerBg(node *domain.NodeInstance) string {
	if node.Definition != nil && node.Definition.Shape.HeaderBackground != "" {
		return node.Definition.Shape.HeaderBackground
	}
	return "var(--surface-2)"
}

func headerColor(node *domain.NodeInstance) string {
	if node.Definition != nil && node.Definition.Shape.HeaderColor != "" {
		return node.Definition.Shape.HeaderColor
	}
	return "var(--text)"
}

func nodeIcon(node *domain.NodeInstance) string {
	if node.Definition != nil && node.Definition.Icon != "" {
		return node.Definition.Icon
	}
	return "?"
}

func portClass(portType domain.PortType, isInput bool) string {
	dir := "output"
	if isInput {
		dir = "input"
	}
	return "port-" + string(portType) + " port-" + dir
}

func nodeWidthInt(node *domain.NodeInstance) int {
	return calcNodeWidth(node)
}

// Layout constants for three-column node layout
const (
	inputLabelColWidth  = 56
	outputLabelColWidth = 56
	colGap              = 8
	minCenterWidth      = 100
)

func hasInputLabels(node *domain.NodeInstance) bool {
	if node.Definition == nil {
		return false
	}
	for _, p := range node.Definition.Inputs {
		if p.Label != "" {
			return true
		}
	}
	return false
}

func hasOutputLabels(node *domain.NodeInstance) bool {
	if node.Definition == nil {
		return false
	}
	for _, p := range node.Definition.Outputs {
		if p.Label != "" {
			return true
		}
	}
	return false
}

func hasBodyAttrs(node *domain.NodeInstance) bool {
	if node.Definition == nil {
		return false
	}
	for _, a := range node.Definition.Attributes {
		if a.Display == domain.DisplayNodeBody || a.Display == domain.DisplayBoth {
			return true
		}
	}
	return false
}

func calcNodeWidth(node *domain.NodeInstance) int {
	baseWidth := 200
	if node.Definition != nil && node.Definition.Shape.Width > 0 {
		baseWidth = node.Definition.Shape.Width
	}
	hasIn := hasInputLabels(node)
	hasOut := hasOutputLabels(node)
	hasBody := hasBodyAttrs(node)
	if hasBody && (hasIn || hasOut) {
		needed := 12 + minCenterWidth + 12
		if hasIn {
			needed += inputLabelColWidth + colGap
		}
		if hasOut {
			needed += outputLabelColWidth + colGap
		}
		if needed > baseWidth {
			return needed
		}
	}
	return baseWidth
}

func bodyAttrX(node *domain.NodeInstance) int {
	if hasInputLabels(node) && hasBodyAttrs(node) {
		return 12 + inputLabelColWidth + colGap
	}
	return 12
}

func portX(node *domain.NodeInstance, port domain.PortDefinition, isInput bool) string {
	if isInput {
		return "0"
	}
	return fmt.Sprintf("%d", nodeWidthInt(node))
}

// portYInt calculates the Y position for a port using auto-distribution.
// Ports are evenly centered within the content area below the header.
func portYInt(node *domain.NodeInstance, isInput bool, index int) int {
	headerHeight := 36
	bottomPadding := 12
	portSpacing := 24

	count := 0
	if node.Definition != nil {
		if isInput {
			count = len(node.Definition.Inputs)
		} else {
			count = len(node.Definition.Outputs)
		}
	}
	if count == 0 {
		return headerHeight
	}

	h := nodeHeightInt(node)
	contentHeight := h - headerHeight - bottomPadding
	startY := headerHeight + (contentHeight-(count-1)*portSpacing)/2
	return startY + index*portSpacing
}

func portY(node *domain.NodeInstance, port domain.PortDefinition, isInput bool, index int) string {
	return fmt.Sprintf("%d", portYInt(node, isInput, index))
}

func portLabelClass(isInput bool) string {
	if isInput {
		return "port-label port-label-input"
	}
	return "port-label port-label-output"
}

func portLabelX(node *domain.NodeInstance, isInput bool) string {
	if isInput {
		return "12"
	}
	return fmt.Sprintf("%d", nodeWidthInt(node)-12)
}

func portLabelY(node *domain.NodeInstance, isInput bool, index int) string {
	return fmt.Sprintf("%d", portYInt(node, isInput, index)+4)
}

func boolStr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

type bodyAttr struct {
	Label string
	Value string
	X     int
	Y     int
}

func bodyAttrs(node *domain.NodeInstance) []bodyAttr {
	var result []bodyAttr
	idx := 0
	x := bodyAttrX(node)
	for _, attr := range node.Definition.Attributes {
		if attr.Display == domain.DisplayNodeBody || attr.Display == domain.DisplayBoth {
			result = append(result, bodyAttr{
				Label: attr.Label,
				Value: attrStr(node.AttributeValues[attr.ID]),
				X:     x,
				Y:     52 + idx*20,
			})
			idx++
		}
	}
	return result
}

func attrStr(v any) string {
	if v == nil {
		return ""
	}
	if s, ok := v.(string); ok {
		return s
	}
	return fmt.Sprintf("%v", v)
}

// findPortY looks up the Y position of a specific port on a node.
func findPortY(node *domain.NodeInstance, portID string) float64 {
	if node.Definition == nil {
		return 36 // fallback to header height
	}
	for i, p := range node.Definition.Outputs {
		if p.ID == portID {
			return float64(portYInt(node, false, i))
		}
	}
	for i, p := range node.Definition.Inputs {
		if p.ID == portID {
			return float64(portYInt(node, true, i))
		}
	}
	// Fallback: center of node
	return float64(nodeHeightInt(node)) / 2
}

func edgePath(wf *domain.Workflow, edge domain.Edge) string {
	srcNode := wf.FindNode(edge.SourceNodeID)
	tgtNode := wf.FindNode(edge.TargetNodeID)
	if srcNode == nil || tgtNode == nil {
		return ""
	}

	srcW := float64(nodeWidthInt(srcNode))

	x1 := srcNode.X + srcW
	y1 := srcNode.Y + findPortY(srcNode, edge.SourcePortID)
	x2 := tgtNode.X
	y2 := tgtNode.Y + findPortY(tgtNode, edge.TargetPortID)
	cpOffset := (x2 - x1) * 0.5
	if cpOffset < 50 {
		cpOffset = 50
	}

	return fmt.Sprintf("M %g %g C %g %g, %g %g, %g %g",
		x1, y1,
		x1+cpOffset, y1,
		x2-cpOffset, y2,
		x2, y2)
}

func diamondPoints(node *domain.NodeInstance) string {
	w := nodeWidthInt(node)
	h := nodeHeightInt(node)
	hw := w / 2
	hh := h / 2
	return fmt.Sprintf("%d %d, %d %d, %d %d, %d %d", hw, 0, w, hh, hw, h, 0, hh)
}

func nodeAriaLabel(node *domain.NodeInstance) string {
	defName := node.DefinitionID
	if node.Definition != nil {
		defName = node.Definition.Name
	}
	return fmt.Sprintf("%s node: %s", defName, node.Label)
}

func edgeAriaLabel(wf *domain.Workflow, edge domain.Edge) string {
	srcNode := wf.FindNode(edge.SourceNodeID)
	tgtNode := wf.FindNode(edge.TargetNodeID)
	srcName := edge.SourceNodeID
	tgtName := edge.TargetNodeID
	if srcNode != nil {
		srcName = srcNode.Label
	}
	if tgtNode != nil {
		tgtName = tgtNode.Label
	}
	return fmt.Sprintf("Connection from %s %s to %s %s", srcName, edge.SourcePortID, tgtName, edge.TargetPortID)
}

func hexagonPoints(node *domain.NodeInstance) string {
	w := nodeWidthInt(node)
	h := nodeHeightInt(node)
	offset := 20
	return fmt.Sprintf("%d %d, %d %d, %d %d, %d %d, %d %d, %d %d",
		offset, 0,
		w-offset, 0,
		w, h/2,
		w-offset, h,
		offset, h,
		0, h/2)
}
