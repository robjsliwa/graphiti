package pages

import (
	"graphiti/internal/domain"
	"graphiti/web/templates/layouts"
	"graphiti/web/templates/partials"
)

type DashboardData struct {
	Username  string
	Workflows []*domain.WorkflowSummary
}

templ Dashboard(data DashboardData) {
	@layouts.Base("Dashboard") {
		<nav class="top-nav">
			<div class="nav-brand">
				@partials.Logo(36)
				<span class="nav-title">Graphiti</span>
			</div>
			<div class="nav-breadcrumb">/ Workflows</div>
			<div class="nav-actions">
				<button class="btn btn-icon" id="theme-toggle" title="Toggle theme"
					@click="themeMode = themeMode === 'light' ? 'dark' : (themeMode === 'dark' ? 'system' : 'light')"
					x-text="themeMode === 'light' ? '\u2600' : (themeMode === 'dark' ? '\u263E' : '\u2699')"
					:aria-label="'Theme: ' + themeMode + '. Click to switch.'">&#x2699;</button>
				<span class="nav-user">{ data.Username }</span>
				<form method="POST" action="/auth/logout" style="display:inline">
					<button type="submit" class="btn btn-ghost">Logout</button>
				</form>
			</div>
		</nav>
		<main class="dashboard">
			<div class="dashboard-header">
				<h1>Workflows</h1>
				<form method="POST" action="/workflows" hx-post="/workflows" hx-swap="none">
					<input type="hidden" name="name" value="Untitled Workflow"/>
					<button type="submit" class="btn btn-primary">+ New Workflow</button>
				</form>
			</div>
			<div class="workflow-grid">
				if len(data.Workflows) == 0 {
					<div class="empty-state">
						<h2>No workflows yet</h2>
						<p>Create your first workflow to get started.</p>
						<form method="POST" action="/workflows" hx-post="/workflows" hx-swap="none" style="margin-top:16px">
							<input type="hidden" name="name" value="Untitled Workflow"/>
							<button type="submit" class="btn btn-primary btn-lg">Create your first workflow</button>
						</form>
					</div>
				}
				for _, wf := range data.Workflows {
					<div class="workflow-card-wrapper">
						<a href={ templ.SafeURL("/workflows/" + wf.ID) } class="workflow-card">
							<div class="workflow-card-header">
								<h3>{ wf.Name }</h3>
								<span class={ "badge", badgeClass(wf.Status) }>{ string(wf.Status) }</span>
								if wf.Status == domain.WorkflowStatusDeployed {
									@partials.DeployVerificationBadge(wf.ID)
								}
							</div>
							<div class="workflow-card-meta">
								<span>v{ itoa(wf.Version) }</span>
								<time
										x-data
										x-text="new Date($el.getAttribute('datetime')).toLocaleDateString(undefined, {month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'})"
										datetime={ wf.UpdatedAt.UTC().Format("2006-01-02T15:04:05Z") }
									>{ wf.UpdatedAt.UTC().Format("Jan 2, 2006 15:04 UTC") }</time>
							</div>
						</a>
						<button
							class="btn btn-ghost btn-sm workflow-delete"
							hx-delete={ "/workflows/" + wf.ID }
							hx-confirm="Delete this workflow? This cannot be undone."
							hx-swap="none"
							title="Delete workflow"
						>&#x2715;</button>
					</div>
				}
			</div>
		</main>
	}
}

func badgeClass(status domain.WorkflowStatus) string {
	switch status {
	case domain.WorkflowStatusDeployed:
		return "badge-success"
	case domain.WorkflowStatusArchived:
		return "badge-muted"
	default:
		return "badge-draft"
	}
}

func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	s := ""
	for n > 0 {
		s = string(rune('0'+n%10)) + s
		n /= 10
	}
	return s
}
