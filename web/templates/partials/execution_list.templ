package partials

import "graphiti/internal/domain"

type ExecutionListData struct {
	WorkflowID string
	Runs       []*domain.ExecutionRunSummary
}

templ ExecutionList(data ExecutionListData) {
	if len(data.Runs) == 0 {
		<div class="empty-state">
			<p>No execution runs yet</p>
			<p class="text-muted">Deploy your workflow to see runs here.</p>
		</div>
	}
	for _, run := range data.Runs {
		<div
			class={ "run-entry", runStatusClass(run.Status) }
			data-run-id={ run.ID }
			hx-get={ "/api/runs/" + run.ID }
			hx-target="#config-content"
			hx-swap="innerHTML"
		>
			<div class="run-entry-header">
				<span class="run-id">{ run.ID[:minLen(len(run.ID), 8)] }</span>
				<span class={ "badge", runBadgeClass(run.Status) }>{ string(run.Status) }</span>
			</div>
			<div class="run-entry-meta">
				if !run.StartedAt.IsZero() {
					<span>{ run.StartedAt.Format("Jan 2, 15:04:05") }</span>
				}
				if !run.CompletedAt.IsZero() && !run.StartedAt.IsZero() {
					<span>{ formatDuration(run.CompletedAt.Sub(run.StartedAt)) }</span>
				}
			</div>
		</div>
	}
}

func runStatusClass(status domain.ExecutionStatus) string {
	switch status {
	case domain.ExecStatusCompleted:
		return "run-completed"
	case domain.ExecStatusFailed:
		return "run-failed"
	case domain.ExecStatusRunning:
		return "run-running"
	default:
		return "run-pending"
	}
}

func runBadgeClass(status domain.ExecutionStatus) string {
	switch status {
	case domain.ExecStatusCompleted:
		return "badge-success"
	case domain.ExecStatusFailed:
		return "badge-danger"
	case domain.ExecStatusRunning:
		return "badge-warning"
	default:
		return "badge-muted"
	}
}

func minLen(a, b int) int {
	if a < b {
		return a
	}
	return b
}

func formatDuration(d interface{ Seconds() float64 }) string {
	s := d.Seconds()
	if s < 1 {
		return "<1s"
	}
	if s < 60 {
		return itoaPartial(int(s)) + "s"
	}
	m := int(s) / 60
	sec := int(s) % 60
	return itoaPartial(m) + "m " + itoaPartial(sec) + "s"
}

func itoaPartial(n int) string {
	if n == 0 {
		return "0"
	}
	s := ""
	for n > 0 {
		s = string(rune('0'+n%10)) + s
		n /= 10
	}
	return s
}
